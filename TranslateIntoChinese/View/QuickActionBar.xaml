<UserControl x:Class="TranslateIntoChinese.View.QuickActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:colors="clr-namespace:TranslateIntoChinese.Utility">
    <Border x:Name="RootBorder"
            CornerRadius="8"
            Padding="6,5"
            Background="#F21E1E1E"
            BorderBrush="#FF007ACC"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Vertical">
            <TextBlock x:Name="BusyText"
                       Text="AI 处理中…"
                       Visibility="Collapsed"
                       Foreground="{Binding Source={x:Static colors:ColorHelper.Second}}"
                       FontSize="11"
                       Margin="2,0,2,4"/>
            <WrapPanel x:Name="ButtonsPanel" MaxWidth="460"/>
        </StackPanel>
    </Border>
</UserControl>
